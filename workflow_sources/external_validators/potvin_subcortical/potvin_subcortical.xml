names></name></person-group><article-title>Using regression equations built from summary data in the psychological assessment of the individual case: extension to multiple regression</article-title><source>Psychol. Assess.</source><volume>24</volume><issue>4</issue><year>2012</year><fpage>801</fpage><lpage>814</lpage><pub-id pub-id-type="pmid">22449035</pub-id><pub-id pub-id-type="doi" assigning-authority="pmc">10.1037/a0027699</pub-id></element-citation></ref></ref-list><sec id="s0030" sec-type="supplementary-material"><label>Transparency document</label><title>Supplementary material</title><p><supplementary-material content-type="local-data" id="ec0005" position="float" orientation="portrait"><caption><p>Supplementary material</p></caption><media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="mmc3.docx" position="float" orientation="portrait"><?suppdata-name mmc3.docx?><?suppdata-size 160887?><?suppdata-md5 92adad8201fb061b8d31e8f9ecbb8747?><?suppdata-image-server-status NEVER_LOAD?><?suppdata-mime-type application?><?suppdata-mime-sub-type vnd.openxmlformats-officedocument.wordprocessingml.document?><?suppdata-cloudpmc-urn urn:app:6727/5094268/92adad8201fb/mmc3.docx?></media></supplementary-material>.</p></sec><sec id="s0040" sec-type="supplementary-material"><label>Appendix A</label><title>Supplementary material</title><p><supplementary-material content-type="local-data" id="ec0010" position="float" orientation="portrait"><caption><p>Supplementary material</p></caption><media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="mmc1.docx" position="float" orientation="portrait"><?suppdata-name mmc1.docx?><?suppdata-size 30766?><?suppdata-md5 09c8dbd081feb75de5fbfddc56043b73?><?suppdata-image-server-status NEVER_LOAD?><?suppdata-mime-type application?><?suppdata-mime-sub-type vnd.openxmlformats-officedocument.wordprocessingml.document?><?suppdata-cloudpmc-urn urn:app:6727/5094268/09c8dbd081fe/mmc1.docx?></media></supplementary-material>.</p><p><suppleme